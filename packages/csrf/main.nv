// csrf — cross-site request forgery protection for Nova forms.
//
// Requires the session package (both ship in the Nova registry):
//
//   import "session";
//   import "csrf";
//   import "forms";
//
//   $sess = $session->start($req, nil);
//
//   // in the form:
//   $forms->open("/contact") . $csrf->hidden($sess) . ...
//
//   // on POST, before doing anything:
//   if (!$csrf->verify($sess, $req)) {
//       return $webx->error_response(403, "invalid CSRF token");
//   }
//
// The token lives in the session store, so it survives across requests
// without extra cookies and rotates on demand (e.g. after login).

import "session";

fn _hexn($n) {
    $chars = "0123456789abcdef";
    $out = "";
    for ($i = 0; $i < $n; $i++) {
        $out .= $chars[rand_int(0, 15)];
    }
    return $out;
}

// current token, creating it (and marking the session dirty) on first use
fn token($sess) {
    $t = $session->get($sess, "_csrf", nil);
    if (is_nil($t) || !is_str($t) || len($t) < 32) {
        $t = _hexn(40);
        $session->put($sess, "_csrf", $t);
    }
    return $t;
}

// force a new token (call after privilege changes)
fn rotate($sess) {
    $t = _hexn(40);
    $session->put($sess, "_csrf", $t);
    return $t;
}

// hidden input for forms
fn hidden($sess) {
    return "<input type=\"hidden\" name=\"_token\" value=\"" . token($sess) . "\">";
}

// <meta> tag for JavaScript (fetch/axios read it and send X-CSRF-Token)
fn meta($sess) {
    return "<meta name=\"csrf-token\" content=\"" . token($sess) . "\">";
}

// constant-shape comparison (same work whether or not it matches)
fn check($sess, $tok) {
    $expected = token($sess);
    if (!is_str($tok) || len($tok) != len($expected)) return false;
    $diff = 0;
    for ($i = 0; $i < len($expected); $i++) {
        if ($expected[$i] != $tok[$i]) $diff++;
    }
    return $diff == 0;
}

// verify the "_token" posted field of a request
fn verify($sess, $req) {
    $tok = "";
    if (is_map($req) && has($req, "form") && has($req->form, "_token")) {
        $tok = $req->form["_token"];
    }
    return check($sess, $tok);
}

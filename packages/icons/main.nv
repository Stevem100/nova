// icons — icon helpers for Nova web apps.
//
// Two providers:
//
// 1. Font Awesome via CDN (thousands of icons, needs internet):
//      icons->fa_link()               // put in <head>
//      icons->fa("house", "solid")    // <i class="fa-solid fa-house"></i>
//
// 2. Offline inline SVG set (24 geometric icons, stroke style, 24x24 grid,
//    rendered in currentColor — style them with CSS "color"):
//      icons->svg("mail")             // <svg ...>
//      icons->svg("mail", 18)         // 18x18
//      icons->svg("mail", 18, "text-red-500")

fn svg_set() {
    return [
        "home"     => "<path d=\"M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z\"/>",
        "user"     => "<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1\"/>",
        "search"   => "<circle cx=\"11\" cy=\"11\" r=\"7\"/><line x1=\"21\" y1=\"21\" x2=\"16.5\" y2=\"16.5\"/>",
        "mail"     => "<rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><polyline points=\"3,7 12,13 21,7\"/>",
        "star"     => "<polygon points=\"12 3 14.8 8.6 21 9.5 16.5 13.9 17.6 20 12 17.2 6.4 20 7.5 13.9 3 9.5 9.2 8.6\"/>",
        "heart"    => "<path d=\"M12 20.5S3.5 15 3.5 9.5A4.5 4.5 0 0 1 12 6.8a4.5 4.5 0 0 1 8.5 2.7c0 5.5-8.5 11-8.5 11z\"/>",
        "check"    => "<polyline points=\"20 6 9 17 4 12\"/>",
        "x"        => "<line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"/><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"/>",
        "menu"     => "<line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"/><line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"/><line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"/>",
        "trash"    => "<polyline points=\"3 6 5 6 21 6\"/><path d=\"M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6\"/><line x1=\"10\" y1=\"11\" x2=\"10\" y2=\"17\"/><line x1=\"14\" y1=\"11\" x2=\"14\" y2=\"17\"/>",
        "settings" => "<circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1\"/>",
        "lock"     => "<rect x=\"4\" y=\"11\" width=\"16\" height=\"10\" rx=\"2\"/><path d=\"M8 11V7a4 4 0 0 1 8 0v4\"/>",
        "download" => "<line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"/><polyline points=\"7 10 12 15 17 10\"/><path d=\"M4 21h16\"/>",
        "upload"   => "<line x1=\"12\" y1=\"21\" x2=\"12\" y2=\"9\"/><polyline points=\"7 14 12 9 17 14\"/><path d=\"M4 3h16\"/>",
        "sun"      => "<circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4\"/>",
        "moon"     => "<path d=\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z\"/>",
        "info"     => "<circle cx=\"12\" cy=\"12\" r=\"9\"/><line x1=\"12\" y1=\"16\" x2=\"12\" y2=\"11\"/><line x1=\"12\" y1=\"8\" x2=\"12.01\" y2=\"8\"/>",
        "warning"  => "<path d=\"M10.3 3.9 1.9 18a2 2 0 0 0 1.7 3h16.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z\"/><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"/><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"/>",
        "plus"     => "<line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"/><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/>",
        "calendar" => "<rect x=\"3\" y=\"4\" width=\"18\" height=\"17\" rx=\"2\"/><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/>",
        "clock"    => "<circle cx=\"12\" cy=\"12\" r=\"9\"/><polyline points=\"12 7 12 12 15.5 14\"/>",
        "globe"    => "<circle cx=\"12\" cy=\"12\" r=\"9\"/><line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"/><path d=\"M12 3a13.5 13.5 0 0 1 3.5 9 13.5 13.5 0 0 1-3.5 9 13.5 13.5 0 0 1-3.5-9A13.5 13.5 0 0 1 12 3z\"/>",
        "bell"     => "<path d=\"M18 8a6 6 0 0 0-12 0c0 7-3 8-3 8h18s-3-1-3-8\"/><path d=\"M13.7 20a2 2 0 0 1-3.4 0\"/>",
        "folder"   => "<path d=\"M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z\"/>",
        "edit"     => "<path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\"/><path d=\"M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4z\"/>"
    ];
}

// ---------- Font Awesome (CDN) ----------

fn fa_link() {
    return "<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css\">";
}

// style: solid|regular|brands|light|duotone (free set: solid/regular/brands)
fn fa($name, $style, $extra_class) {
    if (is_nil($style)) $style = "solid";
    $cls = "fa-" . $style . " fa-" . $name;
    if (!is_nil($extra_class) && $extra_class != "") $cls .= " " . $extra_class;
    return "<i class=\"" . $cls . "\"></i>";
}

// ---------- inline SVG (offline) ----------

fn svg_names() {
    return keys(svg_set());
}

fn has_svg($name) {
    return has(svg_set(), $name);
}

// size: px (default 24); cls: extra class list
fn svg($name, $size, $cls) {
    if (is_nil($size)) $size = 24;
    if (!has_svg($name)) {
        return "<!-- icons: unknown icon \"" . html_escape($name) . "\" -->";
    }
    $set = svg_set();
    $out = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" . str($size)
         . "\" height=\"" . str($size)
         . "\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" "
         . "stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"";
    if (!is_nil($cls) && $cls != "") $out .= " class=\"" . $cls . "\"";
    $out .= " aria-hidden=\"true\">" . $set[$name] . "</svg>";
    return $out;
}

// convenience: icon + label inline, e.g. button content
fn labeled($name, $label, $size) {
    if (is_nil($size)) $size = 16;
    return "<span class=\"inline-flex items-center gap-1.5\">" . svg($name, $size)
         . "<span>" . html_escape($label) . "</span></span>";
}

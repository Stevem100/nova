# .htaccess — pretty URLs + hardening for Nova apps on Apache panels
# (cPanel, Plesk, DirectAdmin, CyberPanel, HestiaCP all use Apache).
#
# Copy this file into your web root (public_html) next to cgi-bin/.
#
# Result: every URL is routed to your Nova app —
#   /                     -> main.nv sees path "/"
#   /about                -> path "/about"
#   /blog/post/3          -> path "/blog/post/3"
#   /cgi-bin/nova.cgi     -> still works directly
# while .nv sources, manifests, the registry, installed packages and
# uploads stay unreachable from the outside.

# ---- 1. pretty URLs ------------------------------------------------------
# Route everything that is not a real file/dir to the Nova CGI wrapper.
# QUERY_STRING is forwarded untouched (QSA), so /search?q=nova works.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ cgi-bin/nova.cgi [QSA,L]
</IfModule>

# ---- 2. never serve source code, manifests, packages or state ------------
# Nova apps are compiled binaries + .nv sources; keep them private.
<FilesMatch "\.(nv|json|lock|md)$">
    Require all denied
</FilesMatch>

<IfModule mod_alias.c>
    RedirectMatch 404 ^/nova_modules(/|$)
    RedirectMatch 404 ^/\.registry(/|$)
    RedirectMatch 404 ^/uploads(/|$)
    RedirectMatch 404 ^/data(/|$)
    RedirectMatch 404 ^/nova$
</IfModule>

# If your panel runs Apache 2.2 instead of 2.4, replace the Require line:
#   <FilesMatch "\.(nv|json|lock|md)$">
#       Order allow,deny
#       Deny from all
#   </FilesMatch>

# ---- 3. sensible defaults for a dynamic app -------------------------------
Options -Indexes
ServerSignature Off

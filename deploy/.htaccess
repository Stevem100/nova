# .htaccess — pretty URLs + hardening for Nova apps on Apache panels
# (cPanel, Plesk, DirectAdmin, CyberPanel, HestiaCP all use Apache).
#
# Copy this file into your web root (public_html) next to cgi-bin/.

# ---- 1. pretty URLs ----------------------------------------------------
# Route everything that is not a real file/dir to the Nova CGI wrapper.
# /about            -> /cgi-bin/nova.cgi            (PATH_INFO not used)
# /blog/post/3      -> /cgi-bin/nova.cgi
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ cgi-bin/nova.cgi [L]
</IfModule>

# ---- 2. never serve source code, packages or the binary ----------------
# Nova apps are compiled binaries + .nv sources; keep them private.
<FilesMatch "\.(nv|json|lock|md)$">
    Require all denied
</FilesMatch>

<IfModule mod_alias.c>
    RedirectMatch 404 ^/nova_modules(/|$)
    RedirectMatch 404 ^/\.registry(/|$)
    RedirectMatch 404 ^/nova$
</IfModule>

# If your panel runs Apache 2.2 instead of 2.4, replace the Require line:
#   <FilesMatch "\.(nv|json|lock|md)$">
#       Order allow,deny
#       Deny from all
#   </FilesMatch>

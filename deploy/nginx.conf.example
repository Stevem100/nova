# Nova — nginx configuration (VPS, or panels that expose nginx:
# CyberPanel, HestiaCP, CloudPanel, aaPanel, RunCloud, ...).
#
# Two modes: CGI through fcgiwrap (shared-host style, zero daemons) or
# plain FastCGI spawning. Mode A is what every panel supports out of the
# box; keep it simple unless you need the throughput.

# ============================================================================
# Mode A — CGI via fcgiwrap (recommended; works everywhere)
# ============================================================================
server {
    listen 80;
    listen 443 ssl http2;
    server_name example.com;

    root /home/nova/app/public;        # or where you put the app
    index index.html;

    # static assets first
    location ~* \.(css|js|png|jpe?g|gif|svg|ico|woff2?)$ {
        expires 7d;
        try_files $uri =404;
    }

    # everything else -> the CGI wrapper, like Apache's RewriteRule above
    location / {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /home/nova/app/deploy/nova.cgi;
        fastcgi_param NOVA_BIN  /home/nova/nova/nova;
        fastcgi_param NOVA_APP  /home/nova/app/main.nv;
        fastcgi_param NOVA_ENV  production;
        fastcgi_pass unix:/run/fcgiwrap.socket;
    }

    # never serve sources, manifests, packages or uploads
    location ~* /(\.registry|nova_modules|uploads|data)/ { deny all; return 403; }
    location ~* \.nv$ { deny all; return 403; }

    # CGI body cap (mirror of web.c's own 32 MiB cap)
    client_max_body_size 32m;
}

# ============================================================================
# Mode B — long-running dev server (nova serve) behind a reverse proxy

// t01 — literals, arithmetic, precedence
echo 42, "\n";
echo -7, "\n";
echo 0x2A, "\n";
echo 3.5, "\n";
echo 1 + 2 * 3, "\n";              // 7
echo (1 + 2) * 3, "\n";            // 9
echo 10 / 4, "\n";                 // 2  (int division, C-style)
echo 10.0 / 4, "\n";               // 2.5
echo 7 % 3, "\n";                  // 1
echo 2 ** 10, "\n";                // 1024
echo 2 ** 0.5, "\n";               // 1.4142135623731
echo 1 + 2 . "x", "\n";            // 3x  (+ binds tighter than .)
echo "n=" . 1 + 2, "\n";           // n=3
echo 5 - -3, "\n";                 // 8
echo -2 ** 2, "\n";                // -4  (** binds tighter than unary -)
echo 10 / 4 * 4, "\n";             // 8
echo 1000000 * 1000000, "\n";      // 1000000000000 (64-bit ints)

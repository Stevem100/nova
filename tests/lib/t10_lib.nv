// t10_lib.nv — companion module for t10

$NAME = "mathlib";
$PI = 3.14159;
$count = 0;

fn add($a, $b) {
    return $a + $b;
}

fn double($x) {
    return add($x, $x);
}

fn counter_bump() {
    $count = $count + 1;
    return $count;
}

class Acc {
    fn init() { $this->bal = 0; }
    fn deposit($amt) { $this->bal = $this->bal + $amt; }
    fn balance() { return $this->bal; }
}

// t04 — arrays
$a = [1, 2, 3];
echo len($a), "\n";                     // 3
echo $a[0], " ", $a[-1], "\n";          // 1 3
push($a, 4, 5);
echo join($a, ","), "\n";               // 1,2,3,4,5
echo pop($a), "\n";                     // 5
echo shift($a), "\n";                   // 1
unshift($a, 0);
echo join($a, ","), "\n";               // 0,2,3,4
insert($a, 1, 99);
echo join($a, ","), "\n";               // 0,99,2,3,4
echo remove($a, 1), "\n";               // 99
echo join($a, ","), "\n";               // 0,2,3,4
$a[] = 7;
$a[] = 8;
echo join($a, ","), "\n";               // 0,2,3,4,7,8
$a[1] = 20;
echo join($a, ","), "\n";               // 0,20,3,4,7,8

echo join([1,2,3,4,5][1..3], " "), "\n";    // 2 3 4
echo join(reverse([1,2,3]), " "), "\n";     // 3 2 1
echo join(sort([3,1,4,1,5,9,2,6]), " "), "\n";
echo join(unique([1,2,2,3,3,3]), " "), "\n";  // 1 2 3
echo index_of([10,20,30], 20), "\n";        // 1
echo index_of([10,20], 99), "\n";           // -1
echo len(concat([1,2],[3],[4,5])), "\n";    // 6

echo join(map([1,2,3], fn($x) { return $x * 10; }), " "), "\n";     // 10 20 30
echo join(filter([1,2,3,4], fn($x) { return $x % 2 == 0; }), " "), "\n";  // 2 4
echo reduce([1,2,3,4], fn($acc, $x) { return $acc + $x; }, 0), "\n";      // 10
echo join(range(1, 5), " "), "\n";          // 1 2 3 4 5
echo join(range(5, 1), " "), "\n";          // 5 4 3 2 1
echo join(range(0, 10, 3), " "), "\n";      // 0 3 6 9
echo sum([1,2,3.5]), "\n";                  // 6.5
echo avg([2,4,6]), "\n";                    // 4
echo min(3,1,2), "/", max(3,1,2), "\n";     // 1/3
echo join(slice([1,2,3,4,5], 1, 3), " "), "\n";   // 2 3
echo join(slice([1,2,3,4,5], -2), " "), "\n";     // 4 5

// sort with comparator: even numbers first
$mixed = [3, 1, 4, 2, 5];
$evens = sort($mixed, fn($a, $b) {
    $ea = $a % 2 == 0; $eb = $b % 2 == 0;
    if ($ea != $eb) return $ea ? -1 : 1;
    return $a - $b;
});
echo join($evens, " "), "\n";               // 2 4 1 3 5

// nested arrays and deep display
$grid = [[1, 2], [3, 4]];
echo $grid[1][0], "\n";                     // 3
echo $grid, "\n";                           // [[1, 2], [3, 4]]

// array equality is deep
echo [1, [2, 3]] == [1, [2, 3]] ? "eq" : "ne", "\n";
echo [1, 2] === [1, 2.0] ? "strict" : "loose", "\n";   // loose: 2 == 2.0

// array + array concatenates
echo join([1, 2] + [3], " "), "\n";         // 1 2 3


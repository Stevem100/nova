// t12 — types, conversions and misc builtins
echo type(nil), type(true), type(1), type(1.5), type("s"), "\n";   // nilboolintfloatstring
echo type([]), type([:]), type(fn() {}), "\n";                     // arraymapfn

echo is_int(1) ? "i" : "-", is_float(1.5) ? "f" : "-", is_num(2) ? "n" : "-", is_str("s") ? "s" : "-", "\n";
echo is_nil(nil) ? "nil " : "-", is_bool(true) ? "b " : "-", is_array([]) ? "a " : "-", is_map([:]) ? "m" : "-", "\n";
echo is_fn(fn() {}) ? "fn " : "-", is_error(error("x")) ? "err" : "-", "\n";

echo int("42abc"), "/", int("abc"), "/", int(true), "/", int(7.9), "\n";   // 42/0/1/7
echo float("3.5x"), "/", float(2), "/", int("  12  "), "\n";               // 3.5/2/12
echo str(1) . str(1.5) . str(true) . str(nil) . "\n";                      // 11.5truenil
echo bool(0) == false && bool("x") == true ? "truth-ok" : "truth-bad", "\n";

echo hex(255), "/", hex(-16), "\n";          // 0xff/-0x10
echo number_format(3.14159, 2), "\n";        // 3.14
echo number_format(7, 0), "\n";              // 7

echo json_encode(["a" => 1, "b" => [true, nil, "x"]]), "\n";
echo json_encode([1, 2, 3]), "\n";
echo json_encode("quote \" inside"), "\n";
try { json_encode(fn() {}); } catch ($e) { echo "json fn caught\n"; }

echo pow(2, 10), "/", sqrt(16), "/", abs(-5), "/", abs(-5.5), "\n";   // 1024/4/5/5.5
echo floor(3.7), " ", ceil(3.2), " ", round(3.5), " ", round(3.4), "\n";  // 3 4 4 3
echo round(-2.5), "\n";                      // -3 (round-half-away-from-zero)

// clock/now are numbers
echo is_num(now()) && is_num(clock_ms()) ? "time-ok" : "time-bad", "\n";

// assert passes silently and throws on failure
assert(1 == 1);
try { assert(false, "custom msg"); } catch ($e) { echo "assert: ", $e->message, "\n"; }

// get_env of a name we set in the runner
echo is_str(get_env("NOVA_TEST_VAR")) || get_env("NOVA_TEST_VAR") == nil ? "env-ok" : "env-bad", "\n";

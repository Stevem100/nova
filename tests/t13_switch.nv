// t13_switch.nv — switch statement: labels, fallthrough, break/continue.
fn classify($n) {
    switch ($n) {
        case 0:
            return "zero";
        case 1:
        case 2:
        case 3:
            return "small";
        case 4:
            return "mid";
        default:
            return "big";
    }
}
foreach ([0, 1, 2, 3, 4, 9] as $n)
    echo $n, "=", classify($n), " ";
echo "\n";

// fallthrough: body without break runs the next branch's body
$x = 2;
switch ($x) {
    case 1:
        echo "a";
    case 2:
        echo "b";
    case 3:
        echo "c";
        break;
    case 4:
        echo "d";
}
echo "\n";

// break exits only the switch, the loop keeps running
foreach ([1, 2, 3] as $n) {
    switch ($n) {
        case 2:
            echo "two!";
            break;
        default:
            echo "n=", $n, ";";
    }
}
echo "\n";

// continue inside a switch skips this loop iteration
$acc = 0;
for ($i = 0; $i < 5; $i++) {
    switch ($i) {
        case 1:
            continue;
        case 3:
            continue;
    }
    $acc += $i;
}
echo "acc=", $acc, "\n";

// string cases and expression labels
$lang = "nova";
switch ($lang) {
    case "php":
        echo "PHP\n";
        break;
    case "nova":
        echo "Nova\n";
        break;
}
switch (6 * 7) {
    case 42:
        echo "answer\n";
        break;
}

// no match, no default -> nothing runs
switch ("zzz") { case "a": echo "never\n"; }
echo "end\n";

// default in the middle still only runs when nothing matched
switch (5) {
    default:
        echo "dflt ";
        break;
    case 5:
        echo "five";
}
echo "\n";

// switch nested inside a switch
switch (1) {
    case 1:
        switch ("s") {
            case "s":
                echo "nested";
                break;
        }
        break;
}
echo "\n";

// switch inside a class method using $this
class Ctl {
    fn pick($k) {
        switch ($k) {
            case "go":  return $this->name . " runs";
            case "stop": return "stopped";
            default: return "?";
        }
    }
    fn init() { $this->name = "motor"; }
}
$m = new Ctl();
echo $m->pick("go"), "/", $m->pick("stop"), "/", $m->pick("x"), "\n";
